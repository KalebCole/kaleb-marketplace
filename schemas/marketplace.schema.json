{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "interface", "plugins"],
  "properties": {
    "name": { "const": "kaleb-marketplace" },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": { "const": "Kaleb Marketplace" }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "policy", "category"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "path"],
                "properties": {
                  "source": { "const": "local" },
                  "path": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "url", "ref"],
                "properties": {
                  "source": { "const": "url" },
                  "url": { "type": "string", "minLength": 1 },
                  "ref": { "type": "string", "minLength": 1 },
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "url", "path", "ref"],
                "properties": {
                  "source": { "const": "git-subdir" },
                  "url": { "type": "string", "minLength": 1 },
                  "path": { "type": "string", "minLength": 1 },
                  "ref": { "type": "string", "minLength": 1 },
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            ]
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["installation", "authentication"],
            "properties": {
              "installation": {
                "type": "string",
                "enum": ["AVAILABLE"]
              },
              "authentication": {
                "type": "string",
                "enum": ["ON_INSTALL"]
              }
            }
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
